# Copy to .env.local and fill in from Supabase → Project Settings → API Keys.
# Use the publishable key (sb_publishable_...). Never put the secret key here:
# every EXPO_PUBLIC_ value is bundled into the app and visible to anyone.
# Leave empty to run on demo data.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
